root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.json]
indent_size = 2
indent_style = space
tab_width = 2
ij_json_array_wrapping = off

[*.md]
indent_size = 2
indent_style = space
tab_width = 2
ij_markdown_wrap_text_if_long = false

[{*.sh,commit-msg,pre-commit}]
indent_size = 4
indent_style = tab
max_line_length = off
tab_width = 4
ij_shell_wrap_long_lines = false

[*.xml]
indent_size = 4
indent_style = space
tab_width = 4
ij_xml_attribute_wrap = off
ij_xml_space_inside_empty_tag = true

[*.yml]
indent_size = 2
indent_style = space
tab_width = 2
